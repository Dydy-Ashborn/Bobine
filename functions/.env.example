# Copie ce fichier en .env (jamais commité, voir .gitignore) et remplis les
# vraies valeurs. Ce .env.example n'en contient volontairement aucune.

# Développeurs → Clés API, en mode Test tant qu'on développe.
STRIPE_SECRET_KEY=sk_test_...

# Généré après création du endpoint webhook dans le dashboard Stripe
# (Développeurs → Webhooks → Ajouter un endpoint), une fois la Cloud
# Function stripeWebhook déployée et son URL connue.
STRIPE_WEBHOOK_SECRET=whsec_...

# URL réelle où Bobine est servi (GitHub Pages ou domaine perso), sans
# slash final. Sert de repli si le front ne transmet pas d'URL de retour.
APP_URL=https://TON-DOMAINE-A-DEFINIR
